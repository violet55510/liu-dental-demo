/* 医师团队局部样式 */

.doc-card {
  padding: 28rpx 24rpx;
}

.doc-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.doc-id {
  margin-left: 20rpx;
  min-width: 0;
}

.doc-name-line {
  display: flex;
  align-items: center;
}

.doc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0D1B2A;
  margin-right: 12rpx;
}

.doc-name-line .chip {
  margin: 0;
}

.doc-title {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #6A7B91;
}

.doc-meta {
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: #F6F9FD;
}

.doc-meta-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.doc-meta-label {
  width: 130rpx;
  font-size: 23rpx;
  color: #6A7B91;
  flex-shrink: 0;
}

.doc-meta-value {
  font-size: 24rpx;
  color: #0D1B2A;
  margin-right: 10rpx;
}

.doc-meta-row .chip {
  margin: 0;
}

.doc-intro {
  display: block;
  font-size: 25rpx;
  color: #33465C;
  line-height: 1.75;
}

.doc-tags {
  margin-top: 16rpx;
}
