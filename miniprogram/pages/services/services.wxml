<!-- 服务项目列表：8 项，点击进入详情 -->
<view class="page">

  <view wx:if="{{loading}}" class="state">正在加载项目…</view>

  <view wx:elif="{{error}}" class="state state--error">
    <text>{{error}}</text>
    <text class="state-tip">先确认后端已启动（npm start，3000 端口）</text>
    <button class="btn btn--ghost" bindtap="reload">重新加载</button>
  </view>

  <block wx:else>
    <view class="section-sub">共 {{services.length}} 个项目｜价格均为演示数据，非最终报价</view>

    <view
      class="card svc-row"
      wx:for="{{services}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openService"
    >
      <view class="svc-row-main">
        <view class="svc-row-head">
          <text class="svc-row-name">{{item.label}}</text>
          <text class="svc-row-price">{{item.price_text}}</text>
        </view>
        <text class="svc-row-desc">{{item.desc}}</text>
        <text class="svc-row-note">{{item.price_note}}</text>
      </view>
      <text class="svc-arrow">›</text>
    </view>

    <view class="demo-note">
      项目与价格由本地后端 /api/public/services 提供；金额为演示数据，
      实际费用以现场检查与结算为准。
    </view>
  </block>
</view>
