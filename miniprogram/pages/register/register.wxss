/* 注册页局部样式：与登录页共用 auth-* 版式 */

.auth-hero {
  padding: 24rpx 12rpx 28rpx;
}

.auth-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0D1B2A;
  line-height: 1.3;
}

.auth-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6A7B91;
  line-height: 1.7;
}

.auth-card {
  padding: 8rpx 28rpx 28rpx;
}

.auth-submit {
  width: 100%;
  margin-top: 28rpx;
}

.auth-links {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.auth-link {
  font-size: 24rpx;
  color: #10538C;
}
