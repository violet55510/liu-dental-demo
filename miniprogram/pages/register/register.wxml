<!-- 注册：只注册病人（服务端硬编码 role=patient，这里没有角色选项） -->
<view class="page">

  <view class="auth-hero">
    <text class="auth-title">注册就诊人账号</text>
    <text class="auth-sub">只需要姓名、手机号与密码。注册后即可在小程序里选医生、选时段、提交预约。</text>
  </view>

  <view class="card auth-card">
    <view class="field">
      <text class="field-label">姓名</text>
      <input
        class="field-input"
        maxlength="20"
        placeholder="就诊人真实姓名（2–20 字）"
        value="{{name}}"
        bindinput="onNameInput" />
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号，登录时也用它"
        value="{{phone}}"
        bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        maxlength="72"
        placeholder="8–72 位，建议字母加数字"
        value="{{password}}"
        bindinput="onPasswordInput" />
    </view>

    <view wx:if="{{error}}" class="form-error">{{error}}</view>

    <button class="btn btn--primary auth-submit" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '提交中…' : '注册'}}
    </button>

    <view class="auth-links">
      <text class="auth-link" bindtap="goLogin">已有账号，去登录</text>
    </view>
  </view>

  <view class="demo-note">
    本页只能注册「病人」账号。医师账号需要走门诊的入驻审核流程，
    不提供自助注册。演示站点不会发送短信验证码，手机号仅存本机数据库。
  </view>
</view>
